{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar C",
            "type": "process",
            "command": "/usr/bin/clang",
            "args": [
                "-g",
                "-Wall",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/cybercafe"
            ],
            "windows": {
                "command": "C:/msys64/ucrt64/bin/gcc.exe",
                "args": [
                    "-g",
                    "-Wall",
                    "main.c",
                    "-o",
                    "${env:TEMP}/cybercafe.exe"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}