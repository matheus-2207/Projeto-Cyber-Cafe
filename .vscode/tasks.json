{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar C (gcc)",
            "type": "cppbuild",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-g",
                "-Wall",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/cybercafe.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
